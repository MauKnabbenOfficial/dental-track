# ===========================================
# Configuração de Ambiente - Exemplo
# ===========================================
# Copie este arquivo para .env.local e ajuste as variáveis

# Modo de Serviço: 
#   'true'  = usa dados Mock (localStorage)
#   'false' = conecta com a API real
VITE_USE_MOCK=true

# URL base da API
VITE_API_URL=http://localhost:5000/api

# Timeout das requisições HTTP (em milissegundos)
VITE_API_TIMEOUT=30000

# Ambiente: development, staging, production
VITE_APP_ENV=development

# Título da aplicação
VITE_APP_TITLE=DentalTrack
