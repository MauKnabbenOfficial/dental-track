          "content": {
            "size": 9468,
            "mimeType": "text/javascript",
            "text": "import { apiClient, buildQueryString } from \"/src/services/http/index.ts\";\n/**\r\n * Implementação API do serviço de Lançamentos Financeiros\r\n */ export const ApiFinancialService = {\n    async getAll () {\n        return apiClient.get(\"/lancamentosfinanceiros\");\n    },\n    async getById (id) {\n        try {\n            return await apiClient.get(`/lancamentosfinanceiros/${id}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        return apiClient.post(\"/lancamentosfinanceiros\", data);\n    },\n    async update (id, data) {\n        return apiClient.put(`/lancamentosfinanceiros/${id}`, data);\n    },\n    async delete (id) {\n        return apiClient.delete(`/lancamentosfinanceiros/${id}`);\n    },\n    async search (filters) {\n        const query = buildQueryString(filters);\n        return apiClient.get(`/lancamentosfinanceiros/buscar${query}`);\n    },\n    async getByTreatmentId (treatmentId) {\n        return apiClient.get(`/lancamentosfinanceiros/atendimento/${treatmentId}`);\n    },\n    async getByPatientId (patientId) {\n        return apiClient.get(`/lancamentosfinanceiros/paciente/${patientId}`);\n    },\n    async getByType (type) {\n        const query = buildQueryString({\n            tipo: type\n        });\n        return apiClient.get(`/lancamentosfinanceiros${query}`);\n    },\n    async getByStatus (status) {\n        const query = buildQueryString({\n            status\n        });\n        return apiClient.get(`/lancamentosfinanceiros${query}`);\n    },\n    async updatePaymentStatus (id, status, paymentDate) {\n        return apiClient.patch(`/lancamentosfinanceiros/${id}/status-pagamento`, {\n            status,\n            dataPagamento: paymentDate\n        });\n    },\n    async getTotalsByPeriod (startDate, endDate) {\n        const query = buildQueryString({\n            dataInicio: startDate,\n            dataFim: endDate\n        });\n        return apiClient.get(`/lancamentosfinanceiros/resumo${query}`);\n    }\n};\n\n//# sourceMappingURL=data:application/json;base64,"
          },
