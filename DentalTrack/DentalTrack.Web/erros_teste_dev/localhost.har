            "mimeType": "text/javascript",
            "text": "import { apiClient } from \"/src/services/http/index.ts\";\nimport { mapApiUserToUser } from \"/src/services/api/ApiAuthService.ts\";\n/**\r\n * Implementação API do serviço de Usuários\r\n */ export const ApiUserService = {\n    async getAll () {\n        const data = await apiClient.get(\"/usuarios\");\n        return data.map((u)=>mapApiUserToUser(u));\n    },\n    async getById (id) {\n        try {\n            const data = await apiClient.get(`/usuarios/${id}`);\n            return mapApiUserToUser(data);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        // send as-is; assume backend accepts similar payload for creation\n        return apiClient.post(\"/usuarios\", data);\n    },\n    async update (id, data) {\n        const updated = await apiClient.put(`/usuarios/${id}`, data);\n        return mapApiUserToUser(updated);\n    },\n    async delete (id) {\n        return apiClient.delete(`/usuarios/${id}`);\n    },\n    async getByRole (role) {\n        const data = await apiClient.get(`/usuarios/perfil/${role}`);\n        return data.map((u)=>mapApiUserToUser(u));\n    },\n    async getDentists () {\n        const data = await apiClient.get(\"/usuarios/dentistas\");\n        return data.map((u)=>mapApiUserToUser(u));\n    }\n};\n\n//# sourceMappingURL=data:application/json;base64,"
          },
