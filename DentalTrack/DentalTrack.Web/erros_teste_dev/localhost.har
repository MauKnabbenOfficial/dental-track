            "size": 13838,
            "mimeType": "text/javascript",
            "text": "import { apiClient, buildQueryString } from \"/src/services/http/index.ts\";\n/**\r\n * Implementação API do serviço de Tratamentos\r\n */ export const ApiTreatmentService = {\n    async getAll () {\n        return apiClient.get(\"/atendimentos\");\n    },\n    async getById (id) {\n        try {\n            return await apiClient.get(`/atendimentos/${id}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        return apiClient.post(\"/atendimentos\", data);\n    },\n    async update (id, data) {\n        return apiClient.put(`/atendimentos/${id}`, data);\n    },\n    async delete (id) {\n        return apiClient.delete(`/atendimentos/${id}`);\n    },\n    async search (filters) {\n        const query = buildQueryString(filters);\n        return apiClient.get(`/atendimentos/buscar${query}`);\n    },\n    async getByPatientId (patientId) {\n        return apiClient.get(`/atendimentos/paciente/${patientId}`);\n    },\n    async getByDentistId (dentistId) {\n        return apiClient.get(`/atendimentos/dentista/${dentistId}`);\n    },\n    async getByStatus (status) {\n        const query = buildQueryString({\n            status\n        });\n        return apiClient.get(`/atendimentos${query}`);\n    },\n    async createWithStages (treatment, stages) {\n        return apiClient.post(\"/atendimentos/com-etapas\", {\n            atendimento: treatment,\n            etapas: stages\n        });\n    }\n};\n/**\r\n * Implementação API do serviço de Etapas de Tratamentos\r\n */ export const ApiTreatmentStageService = {\n    async getAll () {\n        // Nota: Backend não tem endpoint para obter todas as etapas\n        // As etapas são obtidas por tratamento específico via getByTreatmentId()\n        return Promise.resolve([]);\n    },\n    async getById (id) {\n        try {\n            return await apiClient.get(`/atendimentos/etapas/${id}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        return apiClient.post(`/atendimentos/${data.treatmentId}/etapas`, data);\n    },\n    async update (id, data) {\n        return apiClient.put(`/atendimentos/etapas/${id}`, data);\n    },\n    async delete (id) {\n        return apiClient.delete(`/atendimentos/etapas/${id}`);\n    },\n    async getByTreatmentId (treatmentId) {\n        return apiClient.get(`/atendimentos/${treatmentId}/etapas`);\n    },\n    async updateStatus (id, status, dateCompleted) {\n        return apiClient.patch(`/atendimentos/etapas/${id}/status`, {\n            status,\n            dataConclusao: dateCompleted\n        });\n    },\n    async updateChecklist (id, completedItems) {\n        return apiClient.patch(`/atendimentos/etapas/${id}/checklist`, {\n            itensConcluidos: completedItems\n        });\n    },\n    async addAttachment (id, attachment) {\n        return apiClient.post(`/atendimentos/etapas/${id}/anexos`, {\n            anexo: attachment\n        });\n    },\n    async removeAttachment (id, attachment) {\n        return apiClient.delete(`/atendimentos/etapas/${id}/anexos/${encodeURIComponent(attachment)}`);\n    }\n};\n\n//# sourceMappingURL=data:application/json;base64,"
          },
