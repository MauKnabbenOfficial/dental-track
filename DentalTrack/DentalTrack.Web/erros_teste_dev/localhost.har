            "mimeType": "text/javascript",
            "text": "import { apiClient, buildQueryString } from \"/src/services/http/index.ts\";\n/**\r\n * Implementação API do serviço de Pacientes\r\n */ export const ApiPatientService = {\n    async getAll () {\n        return apiClient.get(\"/pacientes\");\n    },\n    async getById (id) {\n        try {\n            return await apiClient.get(`/pacientes/${id}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        return apiClient.post(\"/pacientes\", data);\n    },\n    async update (id, data) {\n        return apiClient.put(`/pacientes/${id}`, data);\n    },\n    async delete (id) {\n        return apiClient.delete(`/pacientes/${id}`);\n    },\n    async search (filters) {\n        const query = buildQueryString(filters);\n        return apiClient.get(`/pacientes/buscar${query}`);\n    },\n    async getByCpf (cpf) {\n        try {\n            const cleanCpf = cpf.replace(/\\D/g, \"\");\n            return await apiClient.get(`/pacientes/cpf/${cleanCpf}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async getByHealthInsurance (insuranceName) {\n        return apiClient.get(`/pacientes/convenio/${encodeURIComponent(insuranceName)}`);\n    }\n};\n\n//# sourceMappingURL=data:application/json;base64,"
