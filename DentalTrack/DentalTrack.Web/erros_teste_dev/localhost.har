            "size": 13996,
            "mimeType": "text/javascript",
            "text": "import { apiClient, buildQueryString } from \"/src/services/http/index.ts\";\n/**\r\n * Implementação API do serviço de Templates de Procedimentos\r\n */ export const ApiProcedureTemplateService = {\n    async getAll () {\n        return apiClient.get(\"/modelosprocedimentos\");\n    },\n    async getById (id) {\n        try {\n            return await apiClient.get(`/modelosprocedimentos/${id}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        return apiClient.post(\"/modelosprocedimentos\", data);\n    },\n    async update (id, data) {\n        return apiClient.put(`/modelosprocedimentos/${id}`, data);\n    },\n    async delete (id) {\n        return apiClient.delete(`/modelosprocedimentos/${id}`);\n    },\n    async getByCategory (category) {\n        const query = buildQueryString({\n            categoria: category\n        });\n        return apiClient.get(`/modelosprocedimentos${query}`);\n    },\n    async getCategories () {\n        return apiClient.get(\"/modelosprocedimentos/categorias\");\n    }\n};\n/**\r\n * Implementação API do serviço de Etapas de Templates de Procedimentos\r\n */ export const ApiProcedureTemplateStageService = {\n    async getAll () {\n        return apiClient.get(\"/modelosetapas\");\n    },\n    async getById (id) {\n        try {\n            return await apiClient.get(`/modelosetapas/${id}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        return apiClient.post(`/modelosprocedimentos/${data.templateId}/etapas`, data);\n    },\n    async update (id, data) {\n        return apiClient.put(`/modelosetapas/${id}`, data);\n    },\n    async delete (id) {\n        return apiClient.delete(`/modelosetapas/${id}`);\n    },\n    async getByTemplateId (templateId) {\n        return apiClient.get(`/modelosprocedimentos/${templateId}/etapas`);\n    },\n    async swapOrder (stageId1, stageId2) {\n        // Nota: Backend não tem endpoint de swap, apenas de reordenação\n        // Esta função não faz nada por enquanto\n        return Promise.resolve();\n    },\n    async reorderStages (templateId, stageIds) {\n        return apiClient.patch(`/modelosprocedimentos/${templateId}/etapas/reordenar`, {\n            idsEtapas: stageIds\n        });\n    }\n};\n/**\r\n * Implementação API do serviço de Templates de Etapas\r\n */ export const ApiStageTemplateService = {\n    async getAll () {\n        return apiClient.get(\"/modelosetapas\");\n    },\n    async getById (id) {\n        try {\n            return await apiClient.get(`/modelosetapas/${id}`);\n        } catch (error) {\n            if (error.status === 404) return undefined;\n            throw error;\n        }\n    },\n    async create (data) {\n        return apiClient.post(\"/modelosetapas\", data);\n    },\n    async update (id, data) {\n        return apiClient.put(`/modelosetapas/${id}`, data);\n    },\n    async delete (id) {\n        return apiClient.delete(`/modelosetapas/${id}`);\n    },\n    async searchByName (name) {\n        const query = buildQueryString({\n            nome: name\n        });\n        return apiClient.get(`/modelosetapas/buscar${query}`);\n    }\n};\n\n//# sourceMappingURL=data:application/json;base64,"
          },
